{
  "uid": "pgveil-overview",
  "title": "pgveil — Zero-Trust PostgreSQL Proxy & PII Masking",
  "tags": ["pgveil", "postgresql", "security", "pii"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Inspected Queries",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(pgveil_queries_total)", "legendFormat": "Queries" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PII Cells Masked on Wire",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(pgveil_pii_fields_masked_total)", "legendFormat": "Masked" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AST Firewall Blocks",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(pgveil_blocked_queries_total)", "legendFormat": "Blocked" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Wire Connections",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "pgveil_active_connections", "legendFormat": "Active" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Proxy Overhead p50 / p95 / p99 (µs)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(pgveil_proxy_overhead_microseconds_bucket[1m])) by (le))", "legendFormat": "p50 (µs)" },
        { "expr": "histogram_quantile(0.95, sum(rate(pgveil_proxy_overhead_microseconds_bucket[1m])) by (le))", "legendFormat": "p95 (µs)" },
        { "expr": "histogram_quantile(0.99, sum(rate(pgveil_proxy_overhead_microseconds_bucket[1m])) by (le))", "legendFormat": "p99 (µs)" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Masked PII Entities by Type (rate/m)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (entity_type) (rate(pgveil_pii_fields_masked_total[1m])) * 60", "legendFormat": "{{entity_type}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Query Decisions by Role",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (role, decision) (rate(pgveil_queries_total[1m])) * 60", "legendFormat": "{{role}} / {{decision}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka Audit Events & Worker Batches",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (topic, status) (rate(pgveil_kafka_events_total[1m])) * 60", "legendFormat": "producer {{topic}} ({{status}})" },
        { "expr": "rate(pgveil_worker_db_batches_total[1m]) * 60", "legendFormat": "worker batches/m" }
      ]
    }
  ]
}
